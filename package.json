{
  "name": "@leon-pixel/mcp-health",
  "version": "1.2.0",
  "description": "CLI that scans MCP server configs and reports health, versions, and broken entries",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "npm run build && node dist/cli.js",
    "check": "npm run build && node dist/cli.js check",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "devtools",
    "cursor",
    "github-action"
  ],
  "author": "leon-pixel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon-pixel/mcp-health.git"
  },
  "bugs": {
    "url": "https://github.com/leon-pixel/mcp-health/issues"
  },
  "homepage": "https://github.com/leon-pixel/mcp-health#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "action.yml"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-health": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
