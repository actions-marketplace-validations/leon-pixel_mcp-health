{
  "$schema": "https://opencode.ai/config.json",
  // Local and remote servers. Other keys are not servers.
  "mcp": {
    "local": {
      "type": "local",
      "command": ["node", "--version"],
      "enabled": true,
    },
    "remote": {
      "type": "remote",
      "url": "https://example.com/mcp",
    },
    "paused": {
      "type": "local",
      "command": ["definitely-missing-binary-xyz"],
      "enabled": false,
    },
  },
  "tools": {
    "local": false,
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5",
    },
  },
  "plugin": ["example"],
}
